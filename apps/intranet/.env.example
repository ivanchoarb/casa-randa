# Copia este archivo a .env.local y completa con las credenciales reales.
# Sin esto la app compila y corre, pero ninguna pantalla puede leer datos reales.

# --- Supabase (obligatorio para toda la app) ---
# Project Settings → API, en el dashboard de Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Service role — SECRETO, nunca lleva prefijo NEXT_PUBLIC_. Solo lo usan
# los jobs de sincronización bajo src/app/api/sync/ y src/app/api/ical/
# (ver supabase/README.md). Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Conexión directa a Postgres — MÁS SECRETO todavía que el service role key
# (da acceso de esquema, no solo de datos). Solo hace falta para aplicar
# migraciones nuevas de supabase/migrations/ (la REST API de PostgREST no
# admite DDL). Botón "Connect" en el dashboard de Supabase → Session pooler
# o Transaction pooler → copia la URI y reemplaza [YOUR-PASSWORD] por la
# contraseña real de la base (Project Settings → Database → reset password
# si no la tienes guardada). No se usa en tiempo de ejecución de la app,
# solo para scripts de migración puntuales.
DATABASE_URL=

# --- Sincronización de calendarios (Fase 2) ---
# URL de exportación del calendario de Airbnb: Calendario → Disponibilidad
# → Sincronización de calendarios → Exportar calendario, en el panel de
# anfitrión de Airbnb.
AIRBNB_ICAL_URL=

# URL de exportación del calendario de Vrbo: Calendario → Importar/Exportar
# calendario, en el panel de anfitrión de Vrbo.
VRBO_ICAL_URL=

# Token propio para proteger los feeds de salida (/api/ical/[canal]) que
# Airbnb y Vrbo van a importar. Inventa una cadena larga y aleatoria — no
# tiene que venir de ningún lado, es un secreto que tú defines.
ICAL_EXPORT_KEY=

# Protege /api/sync/* de que cualquiera los dispare. También lo inventas tú.
SYNC_SECRET=

# --- PriceLabs (Fase 2) ---
# Ajustes → Integraciones de la API, en el dashboard de PriceLabs.
PRICELABS_API_KEY=
# El id de listado que PriceLabs usa internamente (no el de Airbnb) — está
# en la URL del listado dentro del dashboard de PriceLabs.
PRICELABS_LISTING_ID=
# airbnb | vrbo — cuál PMS es la fuente principal en PriceLabs para este listado.
PRICELABS_PMS=airbnb

# --- SMTP (envío de liquidaciones y cotizaciones por correo) ---
# El SMTP transaccional de Dongee para booking@randahome.com — ver
# docs/arquitectura-migracion.md, "Tareas de producción". Sin esto,
# /api/cotizaciones/enviar-correo y el envío de liquidaciones responden
# con un error claro en vez de fallar en silencio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- WhatsApp Business Platform (Cloud API) ---
# Para que /api/cotizaciones/enviar-whatsapp mande el PDF como documento
# real. Ojo: tener la app de WhatsApp Business en el teléfono NO es esto
# — hay que conectar ese número a Meta Business Manager y activar la
# Cloud API ahí. Meta for Developers → tu app → WhatsApp → API Setup.
WHATSAPP_ACCESS_TOKEN=
# El "Phone number ID" que muestra esa misma pantalla (no es el número
# de teléfono en sí).
WHATSAPP_PHONE_NUMBER_ID=
