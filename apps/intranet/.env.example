# Copia este archivo a .env.local y completa con las credenciales reales.
# Sin esto la app compila y corre, pero ninguna pantalla puede leer datos reales.

# --- Supabase (obligatorio para toda la app) ---
# Project Settings → API, en el dashboard de Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Service role — SECRETO, nunca lleva prefijo NEXT_PUBLIC_. Solo lo usan
# los jobs de sincronización bajo src/app/api/sync/ y src/app/api/ical/
# (ver supabase/README.md). Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- Sincronización de calendarios (Fase 2) ---
# URL de exportación del calendario de Airbnb: Calendario → Disponibilidad
# → Sincronización de calendarios → Exportar calendario, en el panel de
# anfitrión de Airbnb.
AIRBNB_ICAL_URL=

# URL de exportación del calendario de Vrbo: Calendario → Importar/Exportar
# calendario, en el panel de anfitrión de Vrbo.
VRBO_ICAL_URL=

# Token propio para proteger los feeds de salida (/api/ical/[canal]) que
# Airbnb y Vrbo van a importar. Inventa una cadena larga y aleatoria — no
# tiene que venir de ningún lado, es un secreto que tú defines.
ICAL_EXPORT_KEY=

# Protege /api/sync/* de que cualquiera los dispare. También lo inventas tú.
SYNC_SECRET=

# --- PriceLabs (Fase 2) ---
# Ajustes → Integraciones de la API, en el dashboard de PriceLabs.
PRICELABS_API_KEY=
# El id de listado que PriceLabs usa internamente (no el de Airbnb) — está
# en la URL del listado dentro del dashboard de PriceLabs.
PRICELABS_LISTING_ID=
# airbnb | vrbo — cuál PMS es la fuente principal en PriceLabs para este listado.
PRICELABS_PMS=airbnb
