# Copia este archivo a .env.local y completa con las credenciales reales.
# Sin esto el sitio compila y corre, pero el formulario de "Solicitar
# estas fechas" no puede enviar la solicitud.

# --- Supabase ---
# El mismo proyecto que usa apps/intranet — Project Settings → API, en
# el dashboard de Supabase. La anon key es segura de exponer al
# navegador (nunca uses aquí la service_role key): las políticas RLS de
# supabase/migrations/0006_rls.sql son las que de verdad restringen qué
# puede hacer el sitio público (solo insertar en `solicitudes`, leer
# disponibilidad/tarifas/catálogo — nada de contabilidad ni reservas
# ajenas).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# --- Service role (popup de descuento) ---
# Solo para el servidor, nunca exponer al navegador. El popup "5% de
# descuento por tu correo" (src/components/ui/PopupDescuento.tsx) escribe
# en `contactos_marketing`, una tabla de apps/intranet cuya política RLS
# exige el permiso "marketing" — un visitante anónimo no tiene sesión, así
# que hace falta el cliente de servicio para insertar ahí. Sin esto el
# popup responde con error al suscribirse. Project Settings → API →
# service_role, mismo proyecto de arriba.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- SMTP (envío del cupón de bienvenida) ---
# El mismo SMTP transaccional de Dongee para booking@randahome.com que ya
# usa apps/intranet (cotizaciones, campañas). Sin esto, el popup guarda la
# suscripción pero no puede mandar el correo con el cupón.
SMTP_HOST=mail.randahome.com
SMTP_PORT=465
SMTP_USER=booking@randahome.com
SMTP_PASS=
